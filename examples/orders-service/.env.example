# orders-service — configuration
#
# Copy to .env in this directory, or set these in the environment.
# Every value is validated at startup: a missing one stops the process with a
# clear message rather than failing later on a request.

# Where this service listens.
ORDERS_ADDR=:9090

# The auth service's base URL. That is the only auth setting needed: the
# issuer, audience and public-key location are read from
# <AUTH_URL>/.well-known/openid-configuration at startup.
AUTH_URL=http://localhost:8080

# Demo only: the user id that owns the seeded orders, so GET /orders/mine
# returns something. Set it to your own user id from /api/v1/auth/me.
SEED_OWNER_ID=
